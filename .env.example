# Token từ @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# User ID được phép dùng bot (lấy qua @userinfobot), nhiều ID cách nhau dấu phẩy
ALLOWED_USER_IDS=123456789
# Thư mục chứa các dự án (/open liệt kê thư mục con, /new tạo thư mục con mới)
PROJECTS_ROOT=/home/ubuntu/projects
# Chế độ quyền mặc định cho topic mới: default | acceptEdits | plan | bypassPermissions
CLAUDE_PERMISSION_MODE=acceptEdits
# (Tuỳ chọn) các tool luôn được phép, không cần bấm duyệt, ví dụ: Bash(git:*), Bash(npm run test)
CLAUDE_ALLOWED_TOOLS=
# (Tuỳ chọn) số giây chờ bấm duyệt quyền trước khi tự từ chối
APPROVAL_TIMEOUT_SECONDS=900
# (Tuỳ chọn) dùng claude CLI đã cài thay vì bản đi kèm Agent SDK
# CLAUDE_BIN=/home/ubuntu/.local/bin/claude

# Engine mặc định cho /new và /open: agy | claude
DEFAULT_ENGINE=agy
# Chế độ quyền mặc định của agy (bypassPermissions = --dangerously-skip-permissions)
AGY_PERMISSION_MODE=bypassPermissions
AGY_BIN=/usr/local/bin/agy
